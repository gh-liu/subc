{
  "outbounds": [
    {{- $first := true -}}
    {{- range . }}
      {{- if eq .Protocol "ss" -}}
        {{- if not $first }},{{ end }}{{ $first = false }}
        {
          "type": "shadowsocks",
          "tag": {{ .NodeName | json }},
          "server": {{ .Host | json }},
          "server_port": {{ .Port }},
          "method": {{ .Method | json }},
          "password": {{ .Password | json }}
        }
      {{- else if eq .Protocol "trojan" -}}
        {{- if not $first }},{{ end }}{{ $first = false }}
        {
          "type": "trojan",
          "tag": {{ .NodeName | json }},
          "server": {{ .Host | json }},
          "server_port": {{ .Port }},
          "password": {{ .Password | json }}{{ template "tls" .Params }}
        }
      {{- else if eq .Protocol "vless" -}}
        {{- if not $first }},{{ end }}{{ $first = false }}
        {
          "type": "vless",
          "tag": {{ .NodeName | json }},
          "server": {{ .Host | json }},
          "server_port": {{ .Port }}{{ template "dial" .Params }},
          "uuid": {{ .UUID | json }}{{ template "vless" .Params }}{{ template "tls" .Params }}
        }
      {{- else if eq .Protocol "hysteria2" -}}
        {{- if not $first }},{{ end }}{{ $first = false }}
        {
          "type": "hysteria2",
          "tag": {{ .NodeName | json }},
          "server": {{ .Host | json }},
          "server_port": {{ .Port }},
          "password": {{ .Password | json }}{{ template "tls" .Params }}
        }
      {{- else if eq .Protocol "anytls" -}}
        {{- if not $first }},{{ end }}{{ $first = false }}
        {
          "type": "anytls",
          "tag": {{ .NodeName | json }},
          "server": {{ .Host | json }},
          "server_port": {{ .Port }},
          "password": {{ .Password | json }}{{ template "tls" .Params }}
        }
      {{- else if eq .Protocol "tuic" -}}
        {{- if not $first }},{{ end }}{{ $first = false }}
        {
          "type": "tuic",
          "tag": {{ .NodeName | json }},
          "server": {{ .Host | json }},
          "server_port": {{ .Port }},
          "uuid": {{ .UUID | json }},
          "password": {{ .Password | json }}{{ template "tls" .Params }}{{ template "tuic" .Params }}
        }
      {{- end -}}
    {{- end }}
  ]
}

{{- define "tls" -}}
  {{- $serverName := or (index . "sni") (index . "peer") -}}
  {{- if or $serverName (index . "tls") (index . "xtls") (index . "security") (index . "pbk") (index . "allowInsecure") (index . "insecure") -}}
    ,
    "tls": {
      "enabled": true
      {{- if $serverName }},
      "server_name": {{ $serverName | json }}
      {{- end }}
      {{- if or (eq (index . "allowInsecure") "1") (eq (index . "insecure") "1") }},
      "insecure": true
      {{- end }}
      {{- if index . "fp" }},
      "utls": {
        "enabled": true,
        "fingerprint": {{ index . "fp" | json }}
      }
      {{- end }}
      {{- if index . "pbk" }},
      "reality": {
        "enabled": true,
        "public_key": {{ index . "pbk" | json }}
        {{- if index . "sid" }},
        "short_id": {{ index . "sid" | json }}
        {{- end }}
      }
      {{- end }}
    }
  {{- end -}}
{{- end -}}

{{- define "vless" -}}
  {{- $flow := index . "flow" -}}
  {{- if and (not $flow) (eq (index . "xtls") "2") -}}
    {{- $flow = "xtls-rprx-vision" -}}
  {{- end -}}
  {{- if $flow }},
  "flow": {{ $flow | json }}
  {{- end }}
{{- end -}}

{{- define "dial" -}}
  {{- if or (eq (index . "tfo") "1") (eq (index . "tfo") "true") }},
  "tcp_fast_open": true
  {{- end }}
{{- end -}}

{{- define "tuic" -}}
  {{- if index . "congestion_control" }},
  "congestion_control": {{ index . "congestion_control" | json }}
  {{- end }}
  {{- if index . "udp_relay_mode" }},
  "udp_relay_mode": {{ index . "udp_relay_mode" | json }}
  {{- end }}
{{- end -}}
